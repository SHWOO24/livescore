# 프로덕션 환경변수 예제 파일
# 
# 사용 방법:
# 1. 이 파일을 .env로 복사
# 2. 실제 값으로 변경
# 3. 절대 Git에 커밋하지 마세요!

# 서버 포트 (Render/Railway는 자동 할당, VPS는 직접 설정)
PORT=5000

# JWT 시크릿 키 (강력한 랜덤 문자열, 최소 32자)
# 생성 방법: openssl rand -base64 32
JWT_SECRET=change_me_to_strong_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# CORS 허용 도메인 (쉼표로 구분)
CORS_ORIGIN=https://scorelivenow.com,https://www.scorelivenow.com

# 프론트엔드 URL (이메일 인증 링크 등에 사용)
FRONTEND_URL=https://scorelivenow.com

# MongoDB 연결 문자열
# MongoDB Atlas 예시: mongodb+srv://username:password@cluster.mongodb.net/livescore
# 로컬 MongoDB 예시: mongodb://localhost:27017/livescore
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/livescore
# 또는
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/livescore

# TheSportsDB API 키 (무료: 123)
THESPORTSDB_API_KEY=123

# 캐시 설정
CACHE_TTL_SECONDS=30

# Primary Sport 폴링 주기 (초) - Soccer
PRIMARY_POLL_INTERVAL_SECONDS=30

# Secondary Sports 폴링 주기 (초) - Basketball, Baseball 등
SECONDARY_POLL_INTERVAL_SECONDS=90

# 기존 호환성 (사용 안 함)
POLL_INTERVAL_SECONDS=30

# 기본 스포츠 목록 (쉼표로 구분)
DEFAULT_SPORTS=Soccer,Basketball,American Football,Baseball,Ice Hockey,Cricket,Tennis,Fighting,Motorsport,Volleyball

# 이메일 설정 (선택사항, 이메일 인증 사용 시 필요)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Node 환경
NODE_ENV=production
