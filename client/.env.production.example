# 프로덕션 환경 변수 예제 파일
# 
# 사용 방법:
# 1. 이 파일을 .env.production으로 복사
# 2. 실제 백엔드 서버 URL로 변경
# 3. npm run build 실행 시 자동으로 적용됨
#
# 주의: Vite는 빌드 시점에 환경변수를 번들에 포함시키므로,
# 빌드 후에는 환경변수를 변경해도 반영되지 않습니다.
# 환경변수를 변경하려면 재빌드가 필요합니다.

# 백엔드 API 서버 URL (필수)
# 예: Render: https://your-app.onrender.com
# 예: Railway: https://your-app.railway.app
# 예: Fly.io: https://your-app.fly.dev
# 예: VPS: https://api.scorelivenow.com
VITE_API_BASE_URL=https://api.scorelivenow.com

# Socket.io 서버 URL (선택, 없으면 VITE_API_BASE_URL 사용)
# 대부분의 경우 VITE_API_BASE_URL과 동일한 URL 사용
VITE_SOCKET_URL=https://api.scorelivenow.com
